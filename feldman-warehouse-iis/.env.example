# ========================================================
# הגדרות שרת וחיבור למסד נתונים SQL Server Express
# ========================================================

# פורט שבו האתר יאזין מקומית (IIS יפנה אליו)
PORT=3000

# כתובת/שם שרת ה-SQL Express (לדוגמה: localhost\SQLEXPRESS או .\\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS

# שם מסד הנתונים שיצרנו בסקריפט
DB_NAME=FeldmanWarehouse

# אפשרות א': הזדהות באמצעות משתמש SQL (מומלץ ב-IIS - למשל sa או משתמש ייעודי)
DB_USER=sa
DB_PASSWORD=YourPasswordHere

# אפשרות ב': במידה ומשתמשים בהזדהות Windows (Windows Authentication):
# השאר את DB_USER ו-DB_PASSWORD ריקים, וה-Application Pool יתחבר עם ה-Identity שלו.

# הגדרת הצפנת חיבור (false כברירת מחדל לשרת מקומי)
DB_ENCRYPT=false
